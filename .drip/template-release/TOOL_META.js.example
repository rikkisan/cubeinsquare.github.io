# Rename to TOOL_META.js only if this bundle introduces a NEW tool.
# Delete it otherwise. All four locales are required.
#
# Both sections declare the same tool key. It is spliced into the meta and
# labels objects in assets/site.js -- never replace that file from a payload.

@meta
"myNewTool": {
          "path": "/my-new-tool/",
          "guidePath": "/wiki-my-new-tool/",
          "sectionId": "how-to-guides"
}
@labels
"myNewTool": {
          "en": {
                    "toolLabel": "My new tool",
                    "guideLabel": "My new tool guide",
                    "featureTitle": "My new tool",
                    "featureDesc": "One sentence for the navbar feature card.",
