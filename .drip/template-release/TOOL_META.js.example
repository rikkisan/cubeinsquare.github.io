                    "catalogDesc": "One sentence for the tools catalog card.",
                    "catalogAction": "Open tool",
                    "catalogStatus": "new",
                    "wikiKicker": "Builder guide",
                    "wikiTitle": "My new tool",
                    "wikiDesc": "One sentence for the wiki card.",
                    "wikiAction": "Read guide",
                    "sidebarLabel": "My new tool"
          },
